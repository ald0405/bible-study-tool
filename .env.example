# Copy this file to .env and fill in your own keys. Never commit .env.

# ESV API (https://api.esv.org/account/) - powers the ESV translation,
# its citation/cross-reference apparatus, and words-of-Christ markup.
ESV_API_TOKEN=YOUR_ESV_API_TOKEN_HERE
ESV_API_BASE=https://api.esv.org/v3

# api.bible (https://scripture.api.bible/) - powers the NIV translation.
# API_BIBLE_NIV_ID is the Bible ID for the specific NIV edition to use.
API_BIBLE_KEY=YOUR_API_BIBLE_KEY_HERE
API_BIBLE_NIV_ID=78a9f6124f344018-01
